{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    /* The core must never see a DOM type. `lib` stops at es2022 and `types` is
       empty so an accidental `document.` is a compile error, not a runtime one. */
    "types": []
  },
  "include": ["src/**/*.ts", "tsdown.config.ts"]
}
