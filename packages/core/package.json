{
  "name": "@eoin/minesweeper-core",
  "version": "0.0.0",
  "description": "Pure, immutable, dependency-free Minesweeper engine: board, reducer, solver, no-guess generator, replay.",
  "license": "MIT",
  "author": "Eoin O'Brien",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "core (esm, gzip)",
      "path": "dist/index.js",
      "limit": "10 kB",
      "gzip": true
    }
  ],
  "devDependencies": {
    "@size-limit/preset-small-lib": "^13.0.3",
    "size-limit": "^13.0.3"
  },
  "keywords": [
    "minesweeper",
    "game",
    "solver",
    "no-guess",
    "deterministic",
    "property-testing"
  ],
  "engines": {
    "node": ">=20"
  }
}
