{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": [],
    /* Resolve the workspace core from source: the site typechecks against the
       real thing, with no build step between an engine edit and a type error. */
    "paths": {
      "@eoin/minesweeper-core": ["../../packages/core/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "vite.config.ts"]
}
